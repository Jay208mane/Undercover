# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/undercover

# ─── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Socket.IO ─────────────────────────────────────────────────────────────────
# Optional: change if running behind a proxy
SOCKET_PATH=/socket.io

# ─── Voice chat (WebRTC signalling) ────────────────────────────────────────────
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=placeholder
# TURN_CREDENTIAL=placeholder
